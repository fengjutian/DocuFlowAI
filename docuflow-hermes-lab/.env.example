# DocuFlow lab server (npm run serve)
DOCUFLOW_API_HOST=127.0.0.1
DOCUFLOW_API_PORT=8787
DOCUFLOW_API_TOKEN=
DOCUFLOW_DATA_DIR=.docuflow-data
DOCUFLOW_WORKTREE_ROOT=
DOCUFLOW_REPOSITORY=

# ACP endpoint for Zed (npm run acp:serve). Zed spawns the command; transport is stdio.
DOCUFLOW_ACP_PROJECT_ID=zed
DOCUFLOW_ACP_CONTEXT_SNAPSHOT=ctx-zed
DOCUFLOW_ACP_POLICY_SNAPSHOT=pol-zed
DOCUFLOW_ACP_TIMEOUT_SECONDS=300

# Hermes version check. Newer CLIs initialize a provider before parsing flags, so point the check at
# the interpreter (reads importlib.metadata) or a command that prints the version.
HERMES_PYTHON=
HERMES_VERSION_COMMAND=
HERMES_COMMAND=hermes

# Hermes HTTP API Server
HERMES_HTTP_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=
HERMES_TIMEOUT_MS=30000
HERMES_EVENT_TIMEOUT_MS=10000
HERMES_MAX_EVENTS=100
HERMES_REPORT_PATH=reports/phase0-http.json

# Hermes TUI Gateway JSON-RPC. The library does not auto-start a process;
# pass these values to JsonRpcStdioClient from a local validation runner.
HERMES_GATEWAY_COMMAND=hermes
HERMES_GATEWAY_ARGS=[]
HERMES_GATEWAY_METHOD=
HERMES_GATEWAY_PARAMS={}
HERMES_GATEWAY_FRAMING=ndjson
HERMES_GATEWAY_MAX_MESSAGE_BYTES=10485760
HERMES_GATEWAY_TIMEOUT_MS=30000
HERMES_GATEWAY_REPORT_PATH=reports/phase0-gateway.json

# Phase 1 adapter smoke test (AT-001..AT-004). Uses HERMES_HTTP_BASE_URL above.
HERMES_PHASE1_PROMPT=Reply with exactly: DOCUFLOW_PHASE1_OK
HERMES_PHASE1_TIMEOUT_MS=60000
HERMES_PHASE1_WORKDIR=
HERMES_PHASE1_PROJECT_ID=phase1-project
HERMES_PHASE1_REPORT_PATH=reports/phase1-adapter.json

# Security boundary probes. Only set the confirmation flag inside a disposable VM/container
# with no production credentials.
HERMES_SECURITY_LAB_CONFIRM=
HERMES_SECURITY_IMAGE=alpine:3.20
HERMES_SECURITY_MEMORY_MB=512
HERMES_SECURITY_CPUS=1
HERMES_SECURITY_PIDS=128
HERMES_SECURITY_TIMEOUT_MS=120000
HERMES_SECURITY_REPORT_PATH=reports/phase0-security-boundary.json

# Agent-level security probes (P0-009/010/011/013). Requires the confirmation flag above and a
# running Hermes; without either, every probe is recorded as blocked.
HERMES_AGENT_SECURITY_TIMEOUT_MS=120000
HERMES_AGENT_SECURITY_REPORT_PATH=reports/phase0-agent-security.json
